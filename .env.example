# My Digital Life - environment variable reference
# This file documents variable NAMES only. Never put real secrets here or commit real values.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (PostgreSQL, e.g. Railway-provided) ---
DATABASE_URL=postgresql://user:password@host:5432/mydigitallife

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_NAME=mdl_session

# --- Object storage (S3-compatible, e.g. Railway bucket) ---
STORAGE_ENDPOINT=https://example-storage-endpoint
STORAGE_REGION=auto
STORAGE_BUCKET=my-digital-life
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# --- Optional / future ---
# OCR_ENABLED=false
# AI_FEATURES_ENABLED=false
