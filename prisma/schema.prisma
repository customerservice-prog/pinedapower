// Prisma schema for "My Digital Life" - Phase 1 data foundation.
// Deliberately minimal: a single unified Item/Asset model instead of
// per-category tables (no CarPhoto, HousePhoto, VacationPhoto, etc).
// This will grow in later phases (Things, Albums, Spaces, Timeline).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-user application: exactly one User row is expected to exist.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ItemType {
  PHOTO
  DOCUMENT
  VIDEO
  NOTE
  OTHER
}

model Item {
  id          String     @id @default(uuid())
  title       String
  type        ItemType
  folderId    String?
  folder      Folder?    @relation(fields: [folderId], references: [id])
  favorite    Boolean    @default(false)
  archivedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assets      Asset[]
  tags        Tag[]      @relation("ItemToTag")
}

enum AssetStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// Asset = a real file (the sacred original, or a derivative such as a
// thumbnail). Originals are never overwritten; derivatives are separate rows.
model Asset {
  id             String      @id @default(uuid())
  itemId         String
  item           Item        @relation(fields: [itemId], references: [id])
  storageKey     String      @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  isOriginal     Boolean     @default(true)
  status         AssetStatus @default(PENDING)
  createdAt      DateTime    @default(now())
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  items Item[] @relation("ItemToTag")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// Family Tree: a simple genealogy graph. Each person can have up to two
// parents and one spouse (both self-relations) - enough to render a real
// branching family tree without a generic many-to-many graph model.
// onDelete: SetNull so removing a person never cascades into deleting
// relatives - it just leaves that particular branch link blank.
model FamilyMember {
  id                String         @id @default(uuid())
  name              String
  gender            Gender         @default(UNKNOWN)
  birthYear         Int?
  deathYear         Int?
  notes             String?
  photoUrl          String?
  parentId1         String?
  parentId2         String?
  parent1           FamilyMember?  @relation("Parent1Children", fields: [parentId1], references: [id], onDelete: SetNull)
  parent2           FamilyMember?  @relation("Parent2Children", fields: [parentId2], references: [id], onDelete: SetNull)
  childrenAsParent1 FamilyMember[] @relation("Parent1Children")
  childrenAsParent2 FamilyMember[] @relation("Parent2Children")
  spouseId          String?        @unique
  spouse            FamilyMember?  @relation("Spouse", fields: [spouseId], references: [id], onDelete: SetNull)
  spouseOf          FamilyMember?  @relation("Spouse")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
